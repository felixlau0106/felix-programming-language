# Felix's Programming Language Code Demo
# Key Ideas:
# Functions require explicit return type and args types so that any reader can easily understand a Function
# Variable types are self-explaining, when user look at the value he should already know the type so there is no point to force user to write type explicitly
# Selling point in short: Python simplicity without indentation mess, TS types clarity without braces hell, C performance.

# """ ... """ string is not yet supported, might add later

def add_nums(a: int, b: int): int
    return a + b
end

def minus_nums(a: int, b: int): int
    return a - b
end

def main(): int
    x = 5
    y = 12
    z = add_nums(x, y)

    if z > 10:
        say(str(z) + " is greater than 10.")
    elif z == 10:
        say(str(z) + " is 10.")
    else:
        say(str(z) + " is less than 10.")
    end

    num = 0

    while num < 20:
        num = add_nums(num, 1)
    end

    say(num)

    return 0
end

# Semicolons are treated as newlines, making one-liners `doable` (allowed, not blessed)
# NOT recommended: Modern like Go, Swift intentionally make it difficult or impossible to smash whole programs into unreadable single-line spaghetti code.
# def add(a: int, b: int): int return a + b end; x = 5; y = 10; say(add(x, y))